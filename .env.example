# Copy to .env and adjust for your machine. Values below match docker-compose.yml defaults.

# Schema owner / admin role. Used ONLY by the Prisma CLI to run migrations
# (CREATE TABLE, CREATE POLICY, GRANT). Never used by the running app.
DATABASE_URL="postgresql://postgres:postgres_dev_password@localhost:5432/plexo?schema=public"

# Restricted runtime role (NOSUPERUSER, NOBYPASSRLS, see docker/postgres-init/01-init-roles.sql).
# This is what the NestJS API actually connects with, so RLS policies apply to it.
APP_DATABASE_URL="postgresql://plexo_app:plexo_dev_password@localhost:5432/plexo?schema=public"

# Generate your own: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="replace-me-with-a-random-64-char-hex-string"
JWT_EXPIRES_IN="8h"

# AES-256-GCM master key used to encrypt tenant secrets at rest (AFIP certs
# today; bank/payment-gateway credentials later). Same generation command as
# JWT_SECRET above - must decode to exactly 32 bytes. Rotating this key makes
# every previously-encrypted secret unreadable, so treat it like a database
# credential: back it up outside the app, don't regenerate it casually.
ENCRYPTION_MASTER_KEY="replace-me-with-a-random-64-char-hex-string"

PORT=3000

# Optional. Without these, invoice emails are only logged (ConsoleEmailSender),
# not sent - fine for local dev. Get a key at https://resend.com, and either
# verify your own sending domain or use their sandbox address for testing.
RESEND_API_KEY=""
EMAIL_FROM="facturas@tudominio.com"

# AFIP (padrón + WSFE) no usan variables de entorno - el certificado se
# carga por tenant desde Preferencias (Company/TenantSettings, cifrado con
# ENCRYPTION_MASTER_KEY). Sin certificado cargado, "Buscar en AFIP" y
# "Emitir factura" fallan con un error claro de "no configurado" - normal
# en desarrollo local hasta que subas uno.

# Coma-separada, sin espacios necesarios (se hace trim de cada email) - los
# emails de usuarios normales (ya logueados en algún tenant) que pueden
# pegarle a /api/admin/* (CRUD de planes, alta de tenant). No es un rol de
# User ni un login separado, ver PlatformAdminGuard.
PLATFORM_ADMIN_EMAILS="owner@demo.plexo"

# Directorio donde BackupSchedulerService (cron diario) escribe cada dump con
# pg_dump. Sin configurar (el default en este repo): el cron sigue corriendo
# pero registra un DatabaseBackup en estado FAILED con un mensaje claro en
# vez de intentar ejecutar pg_dump - no está instalado en esta máquina ni en
# la imagen Docker todavía. Requiere además que pg_dump esté en el PATH del
# proceso (ver docker/Dockerfile.api). Usa DATABASE_URL (el rol admin del
# schema), nunca APP_DATABASE_URL - plexo_app no puede leer filas fuera de
# RLS.
BACKUP_STORAGE_DIR=""

# Base URL of the running web app (Next.js dev server by default). Used to
# build the link inside a "forgot password" email and the final redirect
# after an OAuth login/signup round-trip.
FRONTEND_URL="http://localhost:4200"

# Public origin of THIS api process - used to build the callbackURL each
# OAuth strategy registers with Google/Microsoft (must match exactly what's
# configured in the Google Cloud / Azure AD app registration).
OAUTH_CALLBACK_BASE_URL="http://localhost:3000/api"

# Optional. Without both a provider's ID+secret set, GET /auth/oauth/providers
# reports that provider as unconfigured and the frontend renders its button
# disabled - GoogleOAuthGuard/MicrosoftOAuthGuard also reject the route
# directly with a 400 if someone hits it anyway. Get these from Google Cloud
# Console (OAuth client ID, type "Web application") / Azure AD app
# registrations - redirect URI must be exactly
# "${OAUTH_CALLBACK_BASE_URL}/auth/oauth/google/callback" (or /microsoft/).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
# 'common' accepts both personal and work/school Microsoft accounts - set to
# a specific Azure AD tenant id to restrict sign-in to just that org.
MICROSOFT_TENANT_ID="common"

# "Sign in with Apple" - requires a paid Apple Developer account.
# APPLE_CLIENT_ID: the Services ID you register (e.g. "com.plexo.web"), NOT
#   your app's bundle ID.
# APPLE_TEAM_ID: top-right of the Apple Developer member center.
# APPLE_KEY_ID: the identifier of the Sign in with Apple key you create
#   under Certificates, Identifiers & Profiles → Keys.
# APPLE_PRIVATE_KEY: the full contents of the .p8 file Apple gives you ONCE
#   when you create that key (it can't be re-downloaded) - paste it with
#   literal "\n" in place of real newlines, e.g.
#   "-----BEGIN PRIVATE KEY-----\nMIGTAgEAMBMGByqGSM49AgEGCCqGSM49AwEH...\n-----END PRIVATE KEY-----".
#   AppleStrategy unescapes it back to real newlines at boot.
# Redirect URI registered with Apple must be exactly
# "${OAUTH_CALLBACK_BASE_URL}/auth/oauth/apple/callback" - and unlike
# Google/Microsoft, Apple requires this exact URL served over HTTPS in
# anything but local testing.
APPLE_CLIENT_ID=""
APPLE_TEAM_ID=""
APPLE_KEY_ID=""
APPLE_PRIVATE_KEY=""

# Minutes before a signup verification code / a password-reset link expires.
OTP_EXPIRY_MINUTES="15"
PASSWORD_RESET_TOKEN_EXPIRY_MINUTES="60"

# Which Plan a public self-serve signup's 7-day trial starts on (see
# libs/shared/subscriptions - same trial mechanism admin-created tenants
# already use). Must match an existing Plan.key.
SIGNUP_DEFAULT_PLAN_KEY="SILVER"

# Overrides the default JWT_EXPIRES_IN (8h) when a user checks "Recordarme"
# at login.
JWT_REMEMBER_ME_EXPIRES_IN="30d"
